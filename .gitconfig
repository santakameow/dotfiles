[user]
	name = santakameow
	email = sakanai@cum.army
	signingkey = /home/sakanai/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[pull]
	ff = only
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
[diff]
	colorMoved = zebra
[branch]
	sort = -committerdate
